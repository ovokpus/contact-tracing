# Copy to .env (gitignored). All optional; no keys are needed.
# Size of the SYNTHETIC dataset (fictional businesses, people and scans)
SYNTH_BUSINESSES=600
SYNTH_PEOPLE=2500
SYNTH_DAYS=3
# Set to 1 to regenerate the indices on the next `docker compose up`
RESEED=0

SCANS_INDEX=app_scans
BUSINESSES_INDEX=businesses
ES_HEAP=768m

ES_PORT=9200
API_PORT=8000
FRONTEND_PORT=8080
KIBANA_PORT=5601
